# SPDX-License-Identifier: MPL-2.0
include README.md
include LICENSE
include CONTRIBUTING.md
include SECURITY.md
include THIRD_PARTY_NOTICES.md
include instinct/starter_memories.json
recursive-include instinct/assets *.png
recursive-include instinct *.py
prune docs
prune examples
prune tests
prune build
prune dist
prune .venv
prune venv
prune instinct_data
global-exclude *.sqlite3 *.sqlite3-* *.db *.log .env .env.* *.pyc *.pyo
